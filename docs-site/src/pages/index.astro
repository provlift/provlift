---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

const commands = [
  { name: 'list', label: 'Inventory', tone: 'offline', description: 'Show every required provider, module kind, source address, constraint, lock state, and declaration location.', behavior: 'Read-only. Does not need Terraform or registry access.', flags: ['--provider', '--roots-only', '--show-ignored'], examples: ['provlift list', 'provlift list --provider aws --roots-only', 'provlift list --json'] },
  { name: 'check', label: 'Registry scan', tone: 'network', description: 'Compare locked versions or constraint floors with published provider releases and identify repository or dependency blockers.', behavior: 'Read-only. Exit code 2 can gate CI when upgrades are available.', flags: ['--provider', '--module', '--level', '--exit-code'], examples: ['provlift check', 'provlift check --level patch --exit-code', 'provlift check --provider hashicorp/google --module "platform/*"', 'provlift check --json'] },
  { name: 'drift', label: 'Consistency', tone: 'offline', description: 'Find provider version skew, constraint divergence, and root modules without lock files.', behavior: 'Offline and read-only. Use it before changing provider versions across a repository.', flags: ['--provider', '--exit-code'], examples: ['provlift drift', 'provlift drift --provider google', 'provlift drift --exit-code', 'provlift drift --json'] },
  { name: 'upgrade', label: 'Change set', tone: 'writes files', description: 'Plan and apply provider updates, rewrite only blocking constraints, regenerate lock files through Terraform, and validate the result.', behavior: 'Writes Terraform files and lock files. Major or breaking changes require acknowledgement.', flags: ['--provider', '--module', '--level', '--exact-level', '--allow-major', '--next-major', '--to', '--raise-floor', '--pin-unconstrained', '--dry-run', '--skip-init', '--skip-validate', '--backend', '--platforms', '--fmt', '--pr-body'], examples: ['provlift upgrade --level patch --dry-run', 'provlift upgrade --provider aws --level minor', 'provlift upgrade --provider integrations/github --level major --allow-major', 'provlift upgrade --level patch --terraform-binary tofu', 'provlift upgrade --provider azurerm --level major --exact-level --next-major --allow-major', 'provlift upgrade --level patch --exact-level --pr-body body.md --json'] },
  { name: 'validate', label: 'Safety gate', tone: 'terraform', description: 'Check formatting, initialize roots, validate Terraform configuration, and optionally run a plan.', behavior: 'Runs Terraform. Plan is opt-in and may require backend and cloud credentials.', flags: ['--module', '--plan', '--backend', '--no-init'], examples: ['provlift validate', 'provlift validate --module "envs/*"', 'provlift validate --plan --backend', 'provlift validate --no-init --json'] },
  { name: 'version', label: 'Build info', tone: 'offline', description: 'Inspect the installed CLI version, commit, build date, Go version, and target platform.', behavior: 'Read-only and offline.', flags: ['--json'], examples: ['provlift version', 'provlift version --json'] },
];

const workflow = [
  ['01', 'Discover', 'Inventory modules and provider requirements without touching files.'],
  ['02', 'Choose a stage', 'Run a direct patch, minor, or major budget, or progress through exact stages.'],
  ['03', 'Review the PR', 'CI validates the change, explains blockers, and keeps the lock file honest.'],
];

const flags = [
  ['-C, --dir', '.', 'Repository directory to scan.'],
  ['--json', 'false', 'Emit machine-readable output instead of a table.'],
  ['--exclude', 'none', 'Skip directory globs; repeatable.'],
  ['--terraform-binary', 'terraform', 'Drive Terraform, or OpenTofu with "tofu" (bare provider sources then resolve to registry.opentofu.org).'],
  ['--timeout', '15m', 'Timeout for one Terraform command.'],
  ['--include-prerelease', 'false', 'Include prerelease provider versions in discovery and planning.'],
  ['--level', 'patch', 'Upgrade budget: patch, minor, or major.'],
  ['--exact-level', 'false', 'Apply only the selected level for progressive stages.'],
  ['--allow-major', 'false', 'Acknowledge major or breaking changes.'],
  ['--next-major', 'false', 'Advance one major series at a time.'],
  ['--to', 'none', 'Target one exact provider version.'],
  ['--raise-floor', 'false', 'Raise a shared module minimum to the tested target.'],
  ['--pin-unconstrained', 'false', 'Add a constraint where none exists.'],
  ['--dry-run', 'false', 'Show an upgrade plan without changing files.'],
  ['--skip-init', 'false', 'Edit constraints without regenerating the lock file.'],
  ['--skip-validate', 'false', 'Skip Terraform validation after upgrade.'],
  ['--backend', 'false', 'Allow backend initialization and state access.'],
  ['--platforms', 'config', 'Platforms recorded by terraform providers lock.'],
  ['--fmt', 'true', 'Run terraform fmt on edited directories.'],
  ['--pr-body', 'none', 'Write generated pull request markdown to a file.'],
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="provlift keeps Terraform and OpenTofu providers current across every module: inventory, drift detection, and reviewable upgrades for any provider." />
    <meta name="theme-color" content="#0e1116" />
    <meta property="og:title" content="provlift: provider upgrades for Terraform & OpenTofu" />
    <meta property="og:description" content="Inventory, drift detection, and reviewable provider upgrades for any registry provider." />
    <meta property="og:image" content="https://raw.githubusercontent.com/provlift/provlift/main/brand/github-social-preview-1280x640.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>provlift · Provider upgrades for Terraform & OpenTofu</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon-180.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="#top" aria-label="provlift home"><Logo size={30} /><span class="wordmark">provlift</span></a>
        <nav aria-label="Documentation navigation">
          <div class="nav-label">Start here</div>
          <a class="nav-link active" href="#top">Overview</a>
          <a class="nav-link" href="#commands">Commands</a>
          <a class="nav-link" href="#workflow">Upgrade workflow</a>
          <div class="nav-label">Reference</div>
          <a class="nav-link" href="#flags">Flags</a>
          <a class="nav-link" href="#ci">CI &amp; pull requests</a>
          <div class="nav-label">Project</div>
          <a class="nav-link" href="https://github.com/provlift/provlift" target="_blank" rel="noreferrer">GitHub ↗</a>
          <a class="nav-link" href="https://github.com/provlift/provlift/tree/main/docs" target="_blank" rel="noreferrer">Full documentation ↗</a>
          <a class="nav-link" href="https://github.com/provlift/provlift/blob/main/CONTRIBUTING.md" target="_blank" rel="noreferrer">Contributing ↗</a>
        </nav>
        <div class="sidebar-foot">Apache-2.0 · open source<br />Terraform &amp; OpenTofu</div>
      </aside>

      <main class="main" id="top">
        <div class="topbar">
          <div class="eyebrow">Docs</div>
          <div class="top-actions">
            <label class="search" aria-label="Search documentation">
              <span aria-hidden="true">⌕</span>
              <input id="search" type="search" placeholder="Search commands, flags, concepts" />
              <kbd>/</kbd>
            </label>
            <a class="text-link" href="https://github.com/provlift/provlift/releases" target="_blank" rel="noreferrer">releases ↗</a>
          </div>
        </div>
        <div class="search-feedback" id="search-feedback" aria-live="polite">
          <strong id="search-count"></strong>
          <div class="search-results" id="search-results"></div>
        </div>

        <section class="hero">
          <div>
            <div class="hero-brand"><Logo size={44} /><span class="wordmark">provlift</span></div>
            <h1>Terraform &amp; OpenTofu provider upgrades, <span>automated.</span></h1>
            <p class="hero-copy">Inventory providers across every module, see what the registry allows, and ship one precise, reviewable upgrade PR per provider. Lock files are always regenerated by Terraform or OpenTofu, never hand-edited.</p>
            <div class="install">
              <code><span class="prompt">$</span> go install github.com/provlift/provlift/cmd/provlift@latest</code>
              <button class="copy" type="button" data-copy="go install github.com/provlift/provlift/cmd/provlift@latest">copy</button>
            </div>
            <div class="hero-actions">
              <a class="button primary" href="https://github.com/provlift/provlift/blob/main/docs/quick-start/README.md" target="_blank" rel="noreferrer">Quick start →</a>
              <a class="button ghost" href="https://github.com/provlift/provlift" target="_blank" rel="noreferrer">View on GitHub</a>
            </div>
          </div>
          <div>
            <div class="terminal" aria-label="Example provlift session">
              <div class="terminal-bar"><i></i><i></i><i></i></div>
<pre><span class="prompt">$</span> provlift upgrade --level major --allow-major
<span class="dim">  provider   current     target</span>
  azurerm    3.116.0  <span class="up">→  4.x</span>
  aws        5.100.0  <span class="up">→  6.x</span>
  google     6.50.0   <span class="up">→  7.x</span>
<span class="up">✓</span> constraints rewritten
<span class="up">✓</span> lock files regenerated
<span class="up">✓</span> validated <span class="dim">· ready for review</span></pre>
            </div>
            <div class="providers" aria-label="Supported providers">
              <span>aws</span><span>azurerm</span><span>google</span><span>github</span><span>kubernetes</span><span class="any">+ any provider</span>
            </div>
          </div>
        </section>

        <section class="section" id="commands">
          <div class="section-heading">
            <div class="eyebrow">01 · Commands</div>
            <h2>Find the right command</h2>
            <p class="section-intro"><code>list</code>, <code>check</code>, <code>drift</code> and <code>version</code> never change files. <code>validate</code> runs Terraform init, and <code>upgrade</code> edits constraints, so preview upgrades with <code>--dry-run</code> first.</p>
          </div>
          <div class="command-grid" id="command-grid">
            {commands.map((command) => (
              <article class="card command-card searchable" id={`command-${command.name}`} data-result-title={`provlift ${command.name}`} data-search={`${command.name} ${command.label} ${command.description} ${command.behavior} ${command.flags.join(' ')} ${command.examples.join(' ')}`}>
                <span class={command.tone === 'writes files' ? 'pill writes' : 'pill'}>{command.tone}</span>
                <h3>provlift <span class="cmd">{command.name}</span></h3>
                <p>{command.description}</p>
                <p class="behavior"><strong>Behavior:</strong> {command.behavior}</p>
                <div class="subheading">Flags</div>
                <div class="tag-list">{command.flags.map((flag) => <code>{flag}</code>)}</div>
                <div class="subheading">Examples</div>
                <div class="example-list">{command.examples.map((example) => <div class="code-block"><button class="copy" type="button" data-copy={example}>copy</button>{example}</div>)}</div>
              </article>
            ))}
          </div>
          <div class="no-results" id="no-results">No matching command. Try “upgrade”, “lock”, or “json”.</div>
        </section>

        <section class="section" id="workflow">
          <div class="section-heading"><div class="eyebrow">02 · Method</div><h2>How an upgrade moves</h2><p class="section-intro">Discovery, planning, editing, and validation stay visible as separate steps.</p></div>
          <div class="workflow">
            {workflow.map(([number, title, description]) => <article class="card step"><div class="number">{number}</div><h3>{title}</h3><p>{description}</p></article>)}
          </div>
        </section>

        <section class="section" id="flags">
          <div class="section-heading"><div class="eyebrow">03 · Flags</div><h2>Flag reference</h2><p class="section-intro">Global and upgrade controls in one searchable table.</p></div>
          <div class="table-wrap"><table><thead><tr><th>Flag</th><th>Default</th><th>Use it for</th></tr></thead><tbody>{flags.map(([flag, defaultValue, use]) => <tr id={`flag-${flag.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`} class="searchable" data-result-title={`${flag} flag`} data-search={`${flag} ${defaultValue} ${use}`}><td>{flag}</td><td>{defaultValue}</td><td>{use}</td></tr>)}</tbody></table></div>
        </section>

        <section class="section" id="ci">
          <div class="section-heading"><div class="eyebrow">04 · Automation</div><h2>Pull requests by design</h2><p class="section-intro">CI runs the tool, keeps forge credentials out of the binary, and turns the result into one focused PR per provider.</p></div>
          <div class="automation-grid">
            <article class="card searchable" id="ci-direct" data-result-title="Direct budget workflow" data-search="direct budget patch minor major upgrade"><h3>Direct budget</h3><p>Take the newest release one budget allows. <code>minor</code> includes patch and minor changes; a planned major needs acknowledgement.</p><div class="code-block"><button class="copy" type="button" data-copy="provlift upgrade --provider aws --level minor --json">copy</button>provlift upgrade --provider aws --level minor --json</div></article>
            <article class="card searchable" id="ci-stages" data-result-title="Progressive stages workflow" data-search="progressive exact level patch minor major next major"><h3>Progressive stages</h3><p>Keep patch, minor, and major changes in separate PRs. <code>--next-major</code> crosses one major series at a time.</p><div class="code-block"><button class="copy" type="button" data-copy="provlift upgrade --provider azurerm --level major --exact-level --next-major --allow-major">copy</button>provlift upgrade --provider azurerm --level major --exact-level --next-major --allow-major</div></article>
            <article class="card searchable" id="ci-metadata" data-result-title="Pull request metadata workflow" data-search="pull request json pr body ci"><h3>PR metadata</h3><p>CI consumes the stable JSON shape and generated markdown, without giving the CLI forge credentials.</p><div class="code-block"><button class="copy" type="button" data-copy="provlift upgrade --level patch --exact-level --pr-body body.md --json">copy</button>provlift upgrade --level patch --exact-level --pr-body body.md --json</div></article>
          </div>
        </section>

        <footer>
          <span class="foot-brand"><Logo size={20} />provlift · Apache-2.0</span>
          <span><a href="https://github.com/provlift/provlift" target="_blank" rel="noreferrer">github.com/provlift/provlift</a></span>
        </footer>
      </main>
    </div>

    <script>
      const search = document.querySelector('#search');
      const cards = [...document.querySelectorAll('.searchable')];
      const noResults = document.querySelector('#no-results');
      const searchCount = document.querySelector('#search-count');
      const searchResults = document.querySelector('#search-results');
      search?.addEventListener('input', (event) => {
        const input = event.currentTarget;
        if (!(input instanceof HTMLInputElement)) return;
        const query = input.value.toLowerCase().trim();
        let visible = 0;
        const matches: HTMLElement[] = [];
        cards.forEach((item) => {
          const element = item as HTMLElement;
          const match = !query || (element.dataset.search ?? '').toLowerCase().includes(query);
          element.style.display = match ? '' : 'none';
          if (match) {
            visible++;
            if (query) matches.push(element);
          }
        });
        if (noResults instanceof HTMLElement) noResults.style.display = visible ? 'none' : 'block';
        if (searchCount instanceof HTMLElement) {
          searchCount.textContent = query ? `${visible} result${visible === 1 ? '' : 's'} for “${input.value}”` : '';
        }
        if (searchResults instanceof HTMLElement) {
          searchResults.innerHTML = matches.slice(0, 8).map((element) => `<a href="#${element.id}">${element.dataset.resultTitle ?? 'Documentation result'}</a>`).join('');
          searchResults.style.display = query && matches.length ? 'flex' : 'none';
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === '/' && document.activeElement !== search) { event.preventDefault(); if (search instanceof HTMLInputElement) search.focus(); }
      });
      document.querySelectorAll('[data-copy]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', async () => {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
          const original = button.textContent;
          button.textContent = 'copied';
          setTimeout(() => { button.textContent = original; }, 1200);
        });
      });
    </script>
  </body>
</html>
